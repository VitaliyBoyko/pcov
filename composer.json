{
    "name": "vitaliyboyko/pcov",
    "type": "php-ext",
    "license": "PHP-3.01",
    "description": "PCOV fork for PHP line coverage with synchronous native export and executable-line manifest reuse for large test suites",
    "keywords": ["php", "pcov", "code-coverage", "phpunit", "testing", "php-extension", "magento2"],
    "homepage": "https://github.com/VitaliyBoyko/pcov",
    "support": {
        "issues": "https://github.com/VitaliyBoyko/pcov/issues",
        "source": "https://github.com/VitaliyBoyko/pcov"
    },
    "require": {
        "php": ">=8.3 <8.6"
    },
    "conflict": {
        "pecl/pcov": "*"
    },
    "php-ext": {
        "extension-name": "pcov",
        "support-zts": false,
        "support-nts": true,
        "os-families": ["linux"],
        "configure-options": [
            {
                "name": "enable-pcov",
                "description": "Enable php coverage support"
            }
        ]
    }
}
